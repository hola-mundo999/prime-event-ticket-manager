# Copy the values from your Supabase project into the host's dashboard
# (Render -> Environment, or Vercel -> Settings -> Environment Variables).
# Never commit the real file: .env is gitignored.

# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the "Connection pooling" / Transaction pooler URI (port 6543) for a
# hosted API. It already includes your database password.
DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Shared password the admin console signs in with. Generate a long random one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=replace-with-a-long-random-token

# Optional: SQLite file used only when DATABASE_URL is empty (local dev).
# TICKET_DB_PATH=event_tickets.db
